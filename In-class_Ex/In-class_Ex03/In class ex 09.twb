      <aliases enabled='yes' />
      <column caption='Total Population' datatype='integer' name='[Calculation_1724878680430796801]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Pop])' />
      </column>
      <column caption='Female' datatype='integer' name='[Calculation_1724878680435523587]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Sex] = &apos;Females&apos;&#13;&#10;THEN [Pop]&#13;&#10;END' />
      </column>
      <column caption='Male' datatype='integer' name='[Calculation_1724878680435826692]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Sex] = &apos;Males&apos;&#13;&#10;THEN [Pop]&#13;&#10;END' />
      </column>
      <column caption='Population density' datatype='real' name='[Calculation_1724878680444432389]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Pop])/SUM(AREA([Geometry],&apos;km&apos;))' />
      </column>
      <column caption='log10 TotPop' datatype='real' name='[Calculation_1724878680447225862]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOG([Calculation_1724878680430796801])' />
      </column>
      <column caption='Log10PopDen' datatype='real' name='[Calculation_1724878680447582215]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOG([Calculation_1724878680444432389], 10)' />
      </column>
      <column caption='Population Binned' datatype='string' name='[Calculation_1724878680448819208]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1724878680430796801] &lt; WINDOW_PERCENTILE([Calculation_1724878680430796801], 0.33) THEN &quot;Low&quot;&#13;&#10;ELSEIF[Calculation_1724878680430796801] &lt; WINDOW_PERCENTILE([Calculation_1724878680430796801], 0.66) THEN &quot;Medium&quot;&#13;&#10;ELSE &quot;High&quot;&#13;&#10;END'>
          <table-calc ordering-field='[federated.1agr9qp11x174516g1bxu0545w0s].[SZ]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='Population Density Binned' datatype='string' name='[Calculation_1724878680449511433]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1724878680444432389] &lt; WINDOW_PERCENTILE([Calculation_1724878680444432389], 0.33) THEN &quot;Low&quot;&#13;&#10;ELSEIF[Calculation_1724878680444432389] &lt; WINDOW_PERCENTILE([Calculation_1724878680444432389], 0.66) THEN &quot;Medium&quot;&#13;&#10;ELSE &quot;High&quot;&#13;&#10;END'>
          <table-calc ordering-field='[federated.1agr9qp11x174516g1bxu0545w0s].[SZ]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='Calculation1' datatype='string' name='[Calculation_1724878680449892362]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1724878680444432389] &lt; WINDOW_PERCENTILE([Calculation_1724878680444432389], 0.33) THEN &quot;Low&quot;&#13;&#10;ELSEIF[Calculation_1724878680444432389] &lt; WINDOW_PERCENTILE([Calculation_1724878680444432389], 0.66) THEN &quot;Medium&quot;&#13;&#10;ELSE &quot;High&quot;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Combined Binned' datatype='string' name='[Calculation_1724878680451538955]' role='measure' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1724878680448819208] + &quot;-&quot; + [Calculation_1724878680449511433]'>
